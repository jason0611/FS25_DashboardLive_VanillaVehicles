		<dashboard valueType="dbl.animation" 	cmd="workingWidthSettingAnim" 	jointSide="back"	factor="1" 		jointType="implement" 	displayType="TRANS" node="_dbl_isoBUS_wider_R" maxTrans="0.00196044 -0.10235443 0.01374606" 	minTrans="0.00196044 -0.095 0.01374606" minValueTrans="0" maxValueTrans="1" groups="MOTOR_RUNNING"/>


		<dashboard 																														   displayType="EMITTER" node="_dbl_isoBUS_sliderFake_L" intensity="0.2" 	groups="MOTOR_RUNNING"/>
		<dashboard 																														   displayType="EMITTER" node="dbl_isoBUS_slider_L" intensity="0.2" 	groups="MOTOR_RUNNING"/>
		<dashboard valueType="dbl.animation" 	cmd="rotatePlow" 				jointSide="back"	factor="1" 		jointType="implement" 	displayType="SLIDER" node="dbl_isoBUS_slider_L" minValueSlider="0.25" 	maxValueSlider="0.8"   minActiveValue="0.0" maxActiveValue="1" 	groups="MOTOR_RUNNING"/>
		<dashboard valueType="dbl.animation" 	cmd="rotatePlow" 				jointSide="back"	factor="1" 		jointType="implement" 	displayType="SLIDER" node="dbl_isoBUS_slider_R" minValueSlider="0.3" 	maxValueSlider="0.75" 	minActiveValue="0" 	 maxActiveValue="1.0"	groups="MOTOR_RUNNING"/>

