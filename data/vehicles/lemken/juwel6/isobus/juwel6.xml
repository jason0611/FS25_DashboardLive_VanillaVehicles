		<dashboard displayType="TEXT" valueType="dbl.print" option="1" toStack="LEMworkWidthAnim" 	toLog="always"  node="dblIsobusMathDummy_cp"/>
		<dashboard valueType="dbl.animation" 	cmd="workingWidthSettingAnim" 	jointSide="back"	toLog="always"	factor="10" 	calculate="sub1" fromStack="LEMworkWidthAnim"	jointType="implement" displayType="TEXT" node="dblIsobusPlowDistance_txt" textColor="0 0 0" font="GENERIC" textAlignment="RIGHT" textSize="0.0035" textMask="000 %" groups="MOTOR_RUNNING"/>
